network:
    version: 2
    ethernets:
        eth0:
            dhcp4: false
            dhcp6: false
            addresses:
            - {{ inventory_hostname }}/{{ INTERNAL_NETWORK_RANGE }}
            gateway4: {{ MESH_DG }}
            match:
                macaddress: "{{ eth0_macaddress | lower }}"
            nameservers:
                addresses:
                - 10.10.10.10
                - 1.1.1.1
                search: []
            set-name: eth0